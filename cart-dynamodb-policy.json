{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "CartDynamoDBAccess",
      "Effect": "Allow",
      "Action": [
        "dynamodb:GetItem",
        "dynamodb:PutItem",
        "dynamodb:UpdateItem",
        "dynamodb:DeleteItem",
        "dynamodb:Query",
        "dynamodb:BatchGetItem",
        "dynamodb:BatchWriteItem",
        "dynamodb:DescribeTable"
      ],
      "Resource": [
        "arn:aws:dynamodb:ap-south-1:118051225085:table/Items",
        "arn:aws:dynamodb:ap-south-1:118051225085:table/Items/index/*"
      ]
    }
  ]
}
